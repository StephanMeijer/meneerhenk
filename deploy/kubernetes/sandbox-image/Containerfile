# A default image for the kubernetes workspace backend (#89): what Henk's
# sandbox script needs (sh, coreutils, findutils, GNU grep with PCRE2, tar),
# bash for the `bash` tool, git for the record of changes and the run's own
# commands, catatonit as the Pod's first process, which reaps what a run
# leaves behind, and mise for profiles with toolchain = "mise". Nothing of Henk's
# is in it: the script comes with every request. Build your own from this,
# with the toolchains your repositories need, and pin it by digest:
#   docker build -f deploy/kubernetes/sandbox-image/Containerfile \
#     -t registry.example/henk-sandbox:1 deploy/kubernetes/sandbox-image
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash coreutils findutils grep tar git catatonit ca-certificates curl xz-utils \
 && rm -rf /var/lib/apt/lists/*
# A fixed mise release, checked against the SHA256 kept here, so every
# build installs the same binary. To update it, take the new release's
# lines from its SHASUMS256.txt, and update deploy/sandbox/test-host.Containerfile
# to the same release.
ARG MISE_VERSION=v2026.10.3
ARG MISE_SHA256_X64=8d48bc510b7d844fad0bc7156c0855c2a1e7230c51e498a7f6b63b021f8b57c5
ARG MISE_SHA256_ARM64=357260e28904569a6e7124d33b65cef6d043846c07bb8f4906ddf22cc353d61d
# Set by the builder (BuildKit, podman); a build without it fails here.
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) arch=x64; sum=$MISE_SHA256_X64 ;; \
      arm64) arch=arm64; sum=$MISE_SHA256_ARM64 ;; \
      *) echo "no mise checksum for architecture '$TARGETARCH'" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/mise "https://github.com/jdx/mise/releases/download/$MISE_VERSION/mise-$MISE_VERSION-linux-$arch" \
 && echo "$sum  /tmp/mise" | sha256sum -c - \
 && install -m 0755 /tmp/mise /usr/local/bin/mise \
 && rm /tmp/mise
# The Pod runs as this user (workspace.kubernetes.run_as_user), never root.
RUN useradd --uid 1000 --user-group --no-create-home --home-dir /sandbox sandbox
USER 1000:1000
WORKDIR /sandbox
